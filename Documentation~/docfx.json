{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "manual/**/*.md",
          "manual/**/toc.yml"
        ]
      },
      {
        "files": [
          "api/**/*.md",
          "api/**/*.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "MFramework",
      "_appTitle": "MFramework 中文使用手册与 API 参考",
      "_appFooter": "MFramework · MSTUDIO · Unity 与团结引擎",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "zh-CN"
    }
  }
}
